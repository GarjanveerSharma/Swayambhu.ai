# App
APP_NAME=Offline AI Workbench
APP_ENV=dev
API_PREFIX=/api

# Frontend ka URL (CORS ke liye)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Storage folder
STORAGE_DIR=storage

# Services
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kaunsa model kis kaam ka


MODEL_FAST=qwen3:1.7b
MODEL_REASONING=qwen3:1.7b
MODEL_VISION=qwen2.5vl:3b
MODEL_EMBEDDING=bge-m3